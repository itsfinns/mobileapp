<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mobileapp.QuestionPage"
             Title="QuestionPage">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Button Text="Krijg een vraag"
                FontSize="28"
                x:Name="GetQuestionButton"
                AbsoluteLayout.LayoutBounds="60, 350"
                BackgroundColor="#66BB6A"
                TextColor="White"
                CornerRadius="10"
                WidthRequest="300"
                HeightRequest="100"
                Clicked="GetQuestionButtonClicked"/>
        
    </VerticalStackLayout>
</ContentPage>