<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TriviaApp.TriviaPage"
             Title="Trivia Vragen">
    <StackLayout Padding="20">
        <Button Text="Haal Trivia Vragen Op"
                Command="{Binding HaalVragenCommand}" />
        <CollectionView ItemsSource="{Binding Vragen}" IsVisible="{Binding HeeftVragen}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10">
                        <Label Text="{Binding VraagTekst}" FontAttributes="Bold" />
                        <Label Text="{Binding Categorie}" FontSize="12" TextColor="Green" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>
