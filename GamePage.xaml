<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mobileapp.GamePage"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False"
             BackgroundColor="Cyan">


    <StackLayout Orientation="Horizontal" Spacing="10">
        <!-- Ster 1 -->
        <Image Source="{Binding StarImages[0]}"
                       WidthRequest="40"
                       HeightRequest="40">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding StarTappedCommand}" CommandParameter="1" />
            </Image.GestureRecognizers>
        </Image>

        <!-- Ster 2 -->
        <Image Source="{Binding StarImages[1]}"
                       WidthRequest="40"
                       HeightRequest="40">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding StarTappedCommand}" CommandParameter="2" />
            </Image.GestureRecognizers>
        </Image>

        <!-- Ster 3 -->
        <Image Source="{Binding StarImages[2]}"
                       WidthRequest="40"
                       HeightRequest="40">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding StarTappedCommand}" CommandParameter="3" />
            </Image.GestureRecognizers>
        </Image>

        <!-- Ster 4 -->
        <Image Source="{Binding StarImages[3]}"
                       WidthRequest="40"
                       HeightRequest="40">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding StarTappedCommand}" CommandParameter="4" />
            </Image.GestureRecognizers>
        </Image>

        <!-- Ster 5 -->
        <Image Source="{Binding StarImages[4]}"
                       WidthRequest="40"
                       HeightRequest="40">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding StarTappedCommand}" CommandParameter="5" />
            </Image.GestureRecognizers>
        </Image>

    </StackLayout>

</ContentPage>